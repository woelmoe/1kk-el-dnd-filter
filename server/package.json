{
  "name": "fullstack-test-server",
  "version": "1.0.0",
  "private": true,
  "module": "commonjs",
  "moduleResolution": "node",
  "description": "Backend for the 1M items selector test task",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist --clean",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "rimraf": "^5.0.7",
    "tsup": "^8.5.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}